# ── Projet ──────────────────────────────────────────────────────────────────
PROJECT_NAME=Tsena Anaty API

# ── Base de données ──────────────────────────────────────────────────────────
SQLITE_DATABASE=app.db

# ── Sécurité ─────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_with_a_strong_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# ── Superutilisateur initial ─────────────────────────────────────────────────
FIRST_SUPERUSER=admin@example.com
FIRST_NAME_SUPERUSER=Super
LAST_NAME_SUPERUSER=Admin
FIRST_SUPERUSER_PASSWORD=change_me_strong_password

# ── Docker ───────────────────────────────────────────────────────────────────
IMAGE_NAME=tsena-anaty-api
HOST_PORT=8081
CONTAINER_PORT=8081
TESTING=0
