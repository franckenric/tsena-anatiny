# Base URL used by frontend services (auth, etc.)
# Keep /api/v1 to go through Vite proxy in development.
VITE_API_BASE_URL=/api/v1

# Backend target used by Vite dev server proxy.
VITE_API_PROXY_TARGET=http://localhost:8080

# On-device dev: your PC's LAN IP + Vite port, e.g. http://192.168.68.102:5173.
# Leave empty to serve the bundled dist (production).
VITE_DEV_SERVER_URL=
