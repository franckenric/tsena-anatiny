# Ports publies par docker compose (fichier ignore par git, dupliquez en .env)
HOST_PORT=8081
CONTAINER_PORT=8081
BACK_OFFICE_PORT=5175
FRONT_OFFICE_PORT=5173

# Nom du projet, pilote par docker compose et injecte dans les 3 services :
#   - api          : PROJECT_NAME          → titre Swagger, facture, emails
#   - back-office  : VITE_PROJECT_NAME     → header, footer, ticket, SMS/OTP
#   - front-office : VITE_PROJECT_NAME     → header, footer, PWA, meta tags
# Changer le nom ici et relancer `docker compose up -d --build`.
PROJECT_NAME=Tsena Anatiny

# ── Mode dev : rechargement a chaud sans rebuild d'image ──────────────────────
# ENVIRONMENT=development   → l'API lance uvicorn --reload : un changement de
#     fichier .py relance uvicorn (la source est montée dans le conteneur).
#     Passer ENVIRONMENT=production desactive le reload.
ENVIRONMENT=development
# VITE_USE_POLLING=true      → watcher Vite en polling : les .ts/.tsx sont
#     detectes sur bind mount Docker (Windows/macOS). Desactivable (false)
#     si vous lancez Vite hors conteneur.
VITE_USE_POLLING=true