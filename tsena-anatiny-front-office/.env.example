# Base URL used by frontend services.
# Keep /api/v1 to go through the Vite proxy in development.
VITE_API_BASE_URL=/api/v1

# Backend target used by the Vite dev server proxy.
VITE_API_PROXY_TARGET=http://localhost:8080

# Compte de service utilise pour lire le catalogue. L'API attend un EMAIL
# (clients) ou un numero de telephone (back-office) dans `username`.
# Renseignez l'email d'un compte back-office existant.
VITE_API_EMAIL=
VITE_API_PHONE=0340000000
VITE_API_PASSWORD=change-me

# Google OAuth Client ID (replace with your real Client ID)
VITE_GOOGLE_CLIENT_ID=

# Nombre de produits charges par lot (scroll infini du catalogue).
# 5 pour tester rapidement le scroll infini, 12 en production.
VITE_PRODUCTS_PAGE_SIZE=5