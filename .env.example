# ════════════════════════════════════════════════════════════════════════════
# Tsena Anatiny - variables d'environnement UNIQUES pour les 3 projets :
#   - api          : tsena-anaty-apis   (FastAPI)
#   - back-office  : tsena-anatiny-back-office
#   - front-office : tsena-anatiny-front-office
#
# Ce modele est prevu pour la PRODUCTION (certs + nginx sur gabbieboutique.com).
# Dupliquez-le en .env :  cp .env.example .env   (le .env est ignore par git).
#
# Qui le lit ?
#   - l'API        : python-dotenv (app/core/config.py, remonte jusqu'a ce fichier)
#   - les 2 fronts : Vite (envDir = racine du depot, voir vite.config.ts)
#   - docker       : docker compose (interpolation ${...} ET env_file des conteneurs)
#
# Seules les variables prefixees VITE_ sont exposees au navigateur.
# N'ajoutez PAS de commentaire en fin de ligne apres une valeur : les parseurs
# .env (docker compose, dotenv) considerent tout le reste de la ligne comme la
# valeur. Mettez les commentaires sur leur propre ligne.
# ════════════════════════════════════════════════════════════════════════════

# ── Ports publies par docker compose (cote hote) ─────────────────────────────
# HOST_PORT      : port public de l'API. 2003 en production (nginx proxyfie
#                  /api et /ws vers 127.0.0.1:2003).
HOST_PORT=2003
# CONTAINER_PORT : port uvicorn a l'interieur du conteneur.
CONTAINER_PORT=8081
# BACK_OFFICE_PORT / FRONT_OFFICE_PORT : ports dev uniquement (serveurs Vite).
# En production, nginx sert les builds statiques : ces ports ne servent pas.
BACK_OFFICE_PORT=5175
FRONT_OFFICE_PORT=5176

# ── Nom du projet ────────────────────────────────────────────────────────────
# PROJECT_NAME      : API (titre Swagger, facture, emails)
# VITE_PROJECT_NAME : fronts (header, footer, PWA, meta tags, ticket, SMS/OTP)
# Gardez les DEUX identiques.
PROJECT_NAME=Gabbie Boutique
VITE_PROJECT_NAME=Gabbie Boutique

# ── Mode d'execution ─────────────────────────────────────────────────────────
# ENVIRONMENT=production : pas de reload uvicorn (production).
# VITE_USE_POLLING : utile seulement en dev (bind mount Docker Windows/macOS).
ENVIRONMENT=production
VITE_USE_POLLING=false

# ── Docker ───────────────────────────────────────────────────────────────────
IMAGE_NAME=tsena-anaty-api
TESTING=0

# ── Base de donnees (MySQL / MariaDB) — serveur distant ──────────────────────
# En production, MySQL est sur un serveur SEPARE (IP publique ci-dessous).
#   MYSQL_SERVER : hostname / IP du serveur MySQL (lu par l'API, config.py).
#   MYSQL_PORT   : port d'ecoute de MySQL sur ce serveur.
# Le mot de passe est un SECRET : ce fichier est versionne, ne le mettez PAS ici.
# Renseignez-le dans votre .env (local/serveur), qui est ignore par git.
MYSQL_SERVER=15.204.89.37
MYSQL_PORT=3306
MYSQL_USER=project_generated_user
MYSQL_PASSWORD=change_me_strong_db_password
MYSQL_DATABASE=tsena_anatiny

# ── Securite ─────────────────────────────────────────────────────────────────
# SECRET_KEY : OBLIGATOIRE et stable en prod (sinon les tokens JWT sont
# invalides a chaque redemarrage). Generer avec :
#   openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS (origines autorisees, format JSON) ──────────────────────────────────
BACKEND_CORS_ORIGINS=["https://gabbieboutique.com","https://www.gabbieboutique.com","https://admin.gabbieboutique.com","https://apis.gabbieboutique.com"]

# ── Superutilisateur initial ─────────────────────────────────────────────────
FIRST_SUPERUSER=admin@example.com
FIRST_NAME_SUPERUSER=Super
LAST_NAME_SUPERUSER=Admin
FIRST_SUPERUSER_PASSWORD=change_me_strong_password

# ── Fronts (exposees au navigateur, prefixe VITE_) ───────────────────────────
# VITE_API_BASE_URL : garder /api/v1 (relatif) -> proxy Vite en dev, nginx en prod.
VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET : cible du proxy Vite en DEV uniquement (non utilisee
#                         dans le build de production).
VITE_API_PROXY_TARGET=http://localhost:8081
VITE_API_EMAIL=
VITE_API_PHONE=0340000000
VITE_API_PASSWORD=change-me
VITE_GOOGLE_CLIENT_ID=
VITE_PRODUCTS_PAGE_SIZE=5
VITE_DEV_SERVER_URL=

# ── Gmail SMTP (envoi du code de verification par email) ─────────────────────
# SMTP_PASSWORD = mot de passe d'application Google (16 caracteres), genere sur
# https://myaccount.google.com/apppasswords (PAS le mot de passe du compte).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@gmail.com
SMTP_PASSWORD=
# SMTP_FROM = adresse d'affichage seule, SANS nom de marque : l'API ajoute
# elle-meme "PROJECT_NAME <adresse>". Une forme "Nom <adresse>" produisait un
# en-tete From illisible, et les clients messagerie retombaient sur SMTP_USER.
SMTP_FROM=contact@gabbieboutique.com
SMTP_STARTTLS=1

# ── Web Push (badge + notifications sur l'icone, app fermee) ──────────────────
# Rien a voir avec Gmail : le push passe par FCM (Android/Chrome), APNs
# (iOS/Safari) ou le service Mozilla (Firefox), jamais par un serveur de
# messagerie. Genere les cles avec :
#   python scripts/generate_vapid_keys.py
# Ne regenerez JAMAIS ces cles sans le vouloir : chaque changement invalide
# tous les abonnements push existants (les appareils doivent re-s'abonner).
# Sans ces cles, l'API repond 503 sur /notifications/push/vapid-public-key et
# le badge se limite au compteur affiche dans l'application ouverte.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact obligatoire (RFC 8292) : une URL https ou un mailto.
VAPID_SUBJECT=mailto:contact@gabbieboutique.com

# ── Google OAuth ─────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID doit etre identique au VITE_GOOGLE_CLIENT_ID du front-office.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ───────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
